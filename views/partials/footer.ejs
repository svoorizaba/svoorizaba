<section id="contacto" class="relative border-t border-white/5 mt-4">
  <div class="scanline-bg absolute inset-0 opacity-[0.05] pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-5 md:px-8 py-20 grid md:grid-cols-2 gap-12 relative">
    <div>
      <p class="text-brand-400 text-xs tracking-wide font-medium mb-3">Contacto</p>
      <h2 class="font-display text-3xl md:text-4xl font-600 text-white leading-tight mb-4">
        Contáctanos por WhatsApp o envíanos un mensaje
      </h2>
      <p class="text-slate-400 max-w-md mb-8">
        En SVO estamos listos para ofrecerte una solución de página web hecha a la medida de tu negocio en Orizaba y alrededores.
      </p>
      <div class="space-y-3 text-sm text-slate-300">
        <div class="flex items-center gap-3"><span class="w-8 h-8 rounded-full glass-btn flex items-center justify-center">📞</span> 272 194 7810</div>
        <div class="flex items-center gap-3"><span class="w-8 h-8 rounded-full glass-btn flex items-center justify-center">✉️</span> ventas@svopaginasweb.com</div>
        <div class="flex items-center gap-3"><span class="w-8 h-8 rounded-full glass-btn flex items-center justify-center">📍</span> Orizaba, Veracruz, México</div>
      </div>
    </div>
    <form id="formContacto" class="glass-panel rounded-2xl p-6 md:p-8 space-y-4">
      <div class="grid sm:grid-cols-2 gap-4">
        <input required name="nombre" type="text" placeholder="Nombre" class="field">
        <input required name="telefono" type="tel" placeholder="Teléfono" class="field">
      </div>
      <input required name="email" type="email" placeholder="Correo electrónico" class="field">
      <textarea required name="mensaje" rows="4" placeholder="Cuéntanos sobre tu proyecto" class="field resize-none"></textarea>
      <button type="submit" class="w-full h-12 rounded-xl bg-gradient-to-r from-brand-600 to-cyan-400 text-navy-950 font-semibold hover:opacity-90 transition-opacity">
        Enviar mensaje
      </button>
    </form>
  </div>
</section>

<footer class="border-t border-white/5">
  <div class="max-w-7xl mx-auto px-5 md:px-8 py-8">
    <div class="flex justify-center gap-3 mb-6">
      <a href="#" class="w-9 h-9 rounded-full glass-btn flex items-center justify-center text-sm" aria-label="Facebook">f</a>
      <a href="#" class="w-9 h-9 rounded-full glass-btn flex items-center justify-center text-sm" aria-label="Twitter / X">x</a>
      <a href="#" class="w-9 h-9 rounded-full glass-btn flex items-center justify-center text-sm" aria-label="Tumblr">t</a>
      <a href="#" class="w-9 h-9 rounded-full glass-btn flex items-center justify-center text-sm" aria-label="Instagram">ig</a>
    </div>
    <div class="flex flex-wrap justify-center gap-6 text-sm text-slate-400 mb-6">
      <a href="/#nosotros" class="hover:text-white transition-colors">Nosotros</a>
      <a href="/#testimonios" class="hover:text-white transition-colors">Testimonios</a>
      <a href="/#precio" class="hover:text-white transition-colors">Precio</a>
      <a href="/#faq" class="hover:text-white transition-colors">Faq</a>
      <a href="/#contacto" class="hover:text-white transition-colors">Contacto</a>
    </div>
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500 border-t border-white/5 pt-6">
      <div class="flex items-center gap-2">
        <img src="/img/logo.png" alt="SVO" class="h-6 w-auto brand-logo">
        <span>SVO — Diseño de Páginas Web en Orizaba</span>
      </div>
      <p>© <%= new Date().getFullYear() %> Copyright</p>
      <a href="/admin/login" class="hover:text-slate-300 transition-colors">Panel de administración</a>
    </div>
  </div>
</footer>

