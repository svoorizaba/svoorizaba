  .offer-price-new { font-family: 'Anton', sans-serif; font-size: 22px; color: #0E0F0C; }

  /* ---------- Flujo de pasos ---------- */
  .flow-row { display: flex; align-items: center; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .flow-step {
    display: flex; align-items: center; gap: 10px;
    background: #FCFDF8; border: 2px solid #0E0F0C; border-radius: 999px;
    padding: 10px 20px 10px 10px;
  }
  .flow-step .num {
