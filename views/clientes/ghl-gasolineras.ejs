  }
  .spec-table td { padding: 13px 16px; font-size: 13.5px; color: #252D33; border-bottom: 1px solid #E3E7E5; }
  .spec-table tr:nth-child(even) td { background: #FAFBFA; }
  .spec-table td:first-child { font-weight: 600; }

  /* ---------- Certificaciones ---------- */
  .cert-badge {
    display: flex; align-items: center; gap: 10px;
    border: 1.5px solid #E3E7E5; border-radius: 8px;
    padding: 14px 16px;
    background: #fff;
  }
  .cert-icon { font-size: 20px; }

  .field-ghl {
    width: 100%; height: 46px; padding: 0 14px;
    border-radius: 6px; border: 1.5px solid #3A444C;
    background: #1B2126; color: #F4F6F5; font-size: 14px; outline: none;
  }
  .field-ghl::placeholder { color: #6B747B; }
  textarea.field-ghl { height: auto; padding-top: 12px; resize: none; }
  .field-ghl:focus { border-color: #F5A623; }

  .toast-ghl {
    background: #12161A; color: #F4F6F5; border: 1.5px solid #F5A623;
    font-size: 13px; padding: 12px 16px; border-radius: 6px;
    animation: toastInGhl .25s ease;
  }
  @keyframes toastInGhl { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
</style>
</head>
