<style>
  html { scroll-behavior: smooth; }
  body { background: #F4F6F5; }
  ::selection { background: #F5A623; color: #12161A; }

  .ghl-mark {
    display: inline-flex; align-items: center; justify-content: center;
    width: 42px; height: 42px;
    border-radius: 6px;
    background: #12161A;
    border: 1.5px solid #F5A623;
  }

  .btn-amber {
    display: inline-flex; align-items: center; justify-content: center;
    height: 48px; padding: 0 28px;
    border-radius: 6px;
    background: #F5A623; color: #12161A; font-weight: 700; font-size: 13.5px;
    letter-spacing: .02em; text-transform: uppercase;
    transition: background .2s ease;
  }
  .btn-amber:hover { background: #DB8E12; }

  .btn-line {
    display: inline-flex; align-items: center; justify-content: center;
    height: 48px; padding: 0 28px;
    border-radius: 6px;
    border: 1.5px solid rgba(244,246,245,0.35);
    color: #F4F6F5; font-weight: 600; font-size: 13.5px;
    letter-spacing: .02em; text-transform: uppercase;
    transition: border-color .2s ease, background .2s ease;
  }
  .btn-line:hover { border-color: #F5A623; background: rgba(245,166,35,0.08); }

  .stat-strip { border-top: 1px solid rgba(244,246,245,0.12); }
